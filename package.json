{
  "name": "baton",
  "version": "0.1.0",
  "private": true,
  "description": "Baton: pass the baton from a human rep to an AssemblyAI Voice Agent mid-call, with the case already built.",
  "license": "MIT",
  "author": "Md Abid Hussain",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run bundle:scripts && node scripts/assemble-bundle.mjs",
    "build:vercel": "next build",
    "bundle:scripts": "node scripts/lib/bundle-scripts.mjs",
    "start": "node bundle/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:int": "node scripts/lib/run-with-env.mjs RUN_LIVE=1 -- vitest run tests/integration",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "cron": "tsx --conditions=react-server scripts/cron.ts",
    "secrets:init": "tsx --conditions=react-server scripts/gen-secrets.ts",
    "eval:cache-stt": "tsx --conditions=react-server scripts/eval/cache-stt.ts",
    "eval:extract": "tsx --conditions=react-server scripts/eval/extract.ts",
    "eval:sweep": "tsx --conditions=react-server scripts/eval/sweep.ts",
    "eval:spot": "tsx --conditions=react-server scripts/eval/live-spotcheck.ts",
    "eval:k1": "tsx --conditions=react-server scripts/eval/k1.ts",
    "eval:k2": "tsx --conditions=react-server scripts/eval/k2.ts",
    "eval:report": "tsx --conditions=react-server scripts/eval/report.ts",
    "calls:build": "tsx --conditions=react-server scripts/calls/build-assets.ts",
    "tts:chips": "tsx --conditions=react-server scripts/tts/generate-chips.ts",
    "guard": "tsx scripts/lib/local-open-guard.ts"
  },
  "dependencies": {
    "@polar-sh/checkout": "0.4.1",
    "@polar-sh/sdk": "0.49.0",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "lucide-react": "1.47.0",
    "nanoid": "6.0.1",
    "next": "16.3.6",
    "openai": "7.23.0",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "standardwebhooks": "1.1.1",
    "tailwind-merge": "3.7.0",
    "ws": "8.21.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
