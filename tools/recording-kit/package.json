    "scenarios": "tsx src/cli.ts scenarios",
    "cards": "tsx src/cli.ts cards",
    "list": "tsx src/cli.ts list",
    "report": "tsx src/cli.ts report"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
