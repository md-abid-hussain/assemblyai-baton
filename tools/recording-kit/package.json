{
  "name": "baton-recording-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Day-1 call recording kit for Baton: Twilio dual-channel role-play calls -> per-role 8 kHz WAVs + sidecar JSON (eval ground truth lives in data/scenarios)",
  "scripts": {
    "kit": "tsx src/cli.ts",
