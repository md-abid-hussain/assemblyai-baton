    "timeline": [
      {
        "i": 0,
        "speaker": "rep",
        "tag": "greet",
        "text": "Hi, Maya Ortiz, this is Dana at Cedar Hollow Dental. I’m calling to confirm your appointment and make sure we have the right details before we finish up.",
        "startMs": 800,
        "endMs": 10150,
        "clipHash": "1ac351ee9889c7be50013b71e0061d9628f3b79e651f1040ef6e69678e1ef608"
      },
      {
        "i": 1,
        "speaker": "customer",
        "tag": "answer",
        "text": "Hi, Dana. Thanks for checking in. I’m glad to confirm it; I want to be sure I have everything right, too.",
        "startMs": 10617,
        "endMs": 16637,
        "clipHash": "8cd29b9078d0d2e21d3918c2a19a7aa4a2650b4bbfa37a902f52f83c4e2cb61e"
      },
      {
        "i": 2,
        "speaker": "rep",
        "tag": "ask",
        "text": "Of course. Could you say your full name for me? I want to match it to the patient record before we go over the appointment.",
        "startMs": 17271,
        "endMs": 23381,
        "clipHash": "cf8ecbcf9f5dea99885ddfecfd0c618f593ddc3efbf732dea92e64050d6e93b0"
      },
      {
        "i": 3,
        "speaker": "customer",
        "tag": "answer",
        "text": "Maya Ortiz. That’s the name I use for my dental visits.",
        "startMs": 23895,
        "endMs": 28165,
        "clipHash": "8207c7fa639792d4d33f19b98b37eee5d759b9fc2e8c25cc41d833f138b63082"
      },
      {
        "i": 4,
        "speaker": "rep",
        "tag": "ask",
        "text": "Thanks, I have Maya Ortiz here. And what procedure are you booked in for?",
        "startMs": 28711,
        "endMs": 33191,
        "clipHash": "0067d48d0aac99c9ad8c86cb0a795d43e87a71370b976c560fd31ad7b55dc43c"
      },
      {
        "i": 5,
        "speaker": "customer",
        "tag": "answer",
        "text": "A cleaning. I’m coming in for my regular cleaning, just as planned.",
        "startMs": 33704,
        "endMs": 37664,
        "clipHash": "18f542884ff5bf54fa02c576bcee5b6980ac1b60aa1e6fd8e80988435638e80b"
      },
      {
        "i": 6,
        "speaker": "rep",
        "tag": "readback",
        "text": "A cleaning, got it. Dr. Alina Booth will see you at our Fairview office. What date do you have for the appointment?",
        "startMs": 38024,
        "endMs": 43764,
        "clipHash": "28309516fbf7ef58bf0a74526cfa7b1712fe261511e771e18bd45f649b0ecd48"
      },
      {
        "i": 7,
        "speaker": "customer",
        "tag": "answer",
        "text": "Tuesday the sixth of October. I wrote it down when I made the appointment, so that’s the date I expected.",
        "startMs": 44339,
        "endMs": 50239,
        "clipHash": "12dd9ebe049a14f82d5922f326c56d96d3f2c0cd20cf309786fd30a4fca7b139"
      },
      {
        "i": 8,
        "speaker": "rep",
        "tag": "readback",
        "text": "I have Tuesday, October sixth, as well. That matches our schedule, and I’ve confirmed the date and cleaning in your record.",
        "startMs": 50614,
        "endMs": 57304,
        "clipHash": "cf88b211f67a603c3ac66ee0f867fd1e066ef3839f842cace9ddc431d68dde5d"
      },
      {
        "i": 9,
        "speaker": "customer",
        "tag": "confirm",
        "text": "Great, that all sounds right. Thanks for walking me through it and confirming the appointment details.",
        "startMs": 57929,
        "endMs": 63149,
        "clipHash": "b9df5d393cd9f5b040be146f03a000bc23f1bcf602ac09e1723fc8907a63db7c"
      },
      {
        "i": 10,
        "speaker": "rep",
        "tag": "handoff",
        "text": "OK if my assistant finishes the booking and the deposit? I'll stay on the line.",
        "startMs": 63795,
        "endMs": 67905,
        "clipHash": "c163e63e68a2e024b4396485c34357287e4b0c16da2a33bce9d9a81caefdeceb"
      },
      {
        "i": 11,
        "speaker": "customer",
        "tag": "accept",
        "text": "Sure, go ahead.",
