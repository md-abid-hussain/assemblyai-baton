# AssemblyAI (hackathon credits account) — https://www.assemblyai.com/app/api-keys
ASSEMBLYAI_API_KEY=

# OpenAI — used for orchestration/reasoning agents outside the voice loop
OPENAI_API_KEY=

# Twilio — real phone calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=   # E.164, e.g. +15551234567

# Polar.sh — SANDBOX payments (https://sandbox.polar.sh)
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=     # sandbox Organization Access Token
POLAR_WEBHOOK_SECRET=   # set after the webhook endpoint is registered (post-deploy)
