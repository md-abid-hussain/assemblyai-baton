# Baton environment (DESIGN §3.4). Names and non-secret defaults only: NEVER put real values in this file.
# Local: copy to .env, then `npm run secrets:init` fills the app secrets (marked S) without printing them.
# Zerops: secrets go in the app service's secret env vars (GUI); non-secrets in the same panel or zerops.yml.
# There is no NEXT_PUBLIC_* variable.

# ---- platform ----
DATABASE_URL=                 # local: postgres://postgres:<pw>@localhost:5432/postgres · Zerops: ${db_connectionString}
APP_URL=http://localhost:3000 # Zerops: https://app-xxxx.prg1.zerops.app
BATON_DEPLOY_ID=dev-yourname  # zp-prod | vercel-mirror | dev-<name>
ENABLE_INPROC_WORKER=0        # 1 on Zerops, 0 on Vercel and locally
# PORT=3000
# HOSTNAME=0.0.0.0
# NODE_ENV=production

# ---- AssemblyAI (hackathon credits account) — https://www.assemblyai.com/app/api-keys ----
ASSEMBLYAI_API_KEY=           # S: token mint, async, VA REST, promote

# ---- OpenAI — extractor, verifier, TTS (outside the voice loop) ----
OPENAI_API_KEY=               # S

# ---- Polar.sh — SANDBOX payments (https://sandbox.polar.sh) ----
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=           # S: sandbox Organization Access Token (checkouts, products, customers read/write)
POLAR_PRODUCT_ID=             # uuid of the one-time product carrying the ad-hoc per-checkout price (§5.12)
POLAR_WEBHOOK_SECRET=         # S: whsec_… set after the webhook endpoint is registered (post-deploy)
POLAR_DEMO_CUSTOMER_EMAIL=    # an org-member alias, e.g. baton.demo+judge@example.com
POLAR_DEMO_CUSTOMERS=         # JSON {"s01":"<customer uuid>",…} from scripts/polar/setup.ts
EMBED_ORIGINS=                # comma list: the Zerops subdomain, optional custom domain, Vercel mirror
PAYMENTS_MODE=mock            # polar | mock (Simulate works in both)

# ---- app secrets (S) — generated by `npm run secrets:init`; copy the same values to Zerops ----
CASE_TOKEN_SECRET=
VISITOR_SECRET=
ADMIN_KEY=
CRON_SECRET=
AAI_WEBHOOK_SECRET=
AGENT_TOOL_SECRET=
LIMITS_AUTHORITY_KEY=         # the SAME value on the Zerops authority and every remote

# ---- limits authority (DESIGN §2.3) ----
LIMITS_ROLE=remote            # authority on Zerops; remote everywhere else
LIMITS_AUTHORITY_URL=         # the Zerops APP_URL; leave EMPTY before the first deploy → the laptop file guard applies

# ---- ledger, caps, judging window (DESIGN §7.2, §7.3) ----
LEDGER_EPOCH=                 # ISO time set at the D6 deploy freeze, e.g. 2026-09-30T02:30:00Z
AAI_JUDGING_BUDGET_USD=28.00
AAI_RESERVE_USD=5.00
AAI_DAILY_CAP_MAX_USD=3.00
JUDGING_END_DATE=2026-10-21
OPENAI_DAILY_CAP_USD=3.00
STT_OPENS_PER_MIN=4
STT_QUEUE_MAX_WAIT_S=15
VA_MAX_CONCURRENT=3
VA_SESSION_CAP_BASE_MS=150000
VA_SESSION_CAP_PER_FIELD_MS=15000
VA_SESSION_CAP_MAX_MS=420000

# ---- Voice Agent and product switches ----
VA_KEYTERMS=1                 # T-D1-0 passed with keyterms (G1)
VA_VOICE=alba
PAY_TOOL_MODE=push            # hold | push (T-D1-1: push, G1)
DISCLOSURE_TAX_SUFFIX=0       # 1 adds the "+ tax" phrase after {dueToday} (T-D1-9: not needed, G2)
FEATURE_BE_CUSTOMER=0         # P2 is cut

# ---- laptop file guard (scripts/lib/local-open-guard.ts; optional overrides) ----
# LOCAL_GUARD_DIR=            # default ~/.baton/limits (shared by every worktree)
# LOCAL_GUARD_VA_MAX=1
# LOCAL_GUARD_DAILY_CAP_USD=5

# ---- Twilio — real phone calls (recording kit only; NOT deployed) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=            # S
TWILIO_PHONE_NUMBER=          # E.164, e.g. +15551234567
